PORT=3000
NODE_ENV=development
DATABASE_URL=file:./dev.db
JWT_SECRET=your-jwt-secret-key
SOCKET_IO_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Authentication & OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Connectors: Slack & Jira
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret

# AI Providers (Choose: claude | gemini | bedrock | openrouter)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# AWS Bedrock Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_CHEAP_MODEL_ID=amazon.nova-lite-v1:0
ARCHIVE_BUCKET=your-archive-bucket-name

# OpenRouter (Alternative)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL_ID=google/gemini-2.5-flash
OPENROUTER_CHEAP_MODEL_ID=google/gemini-2.0-flash-001
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Conti-Newty
