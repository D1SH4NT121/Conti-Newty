{
  "name": "conti-newty-workbench",
  "version": "1.0.0",
  "description": "Workbench implementation for Conti-Newty",
  "main": "src/server.ts",
  "scripts": {
    "build:backend": "tsc",
    "build:web": "npm --prefix apps/web run build",
    "build": "tsc && npm --prefix apps/web run build",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "seed": "ts-node scripts/demo-seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.9.0",
    "@prisma/client": "^4.14.0",
    "adm-zip": "^0.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "prisma": "^4.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.7.2",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.38.0",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.3"
  }
}
